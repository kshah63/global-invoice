# ---------------------------------------------------------------------------
# Global Online Invoicing App — environment variables
# Copy this file to .env.local and fill in values from your Supabase project.
# In Vercel, add these under Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
# Supabase Dashboard → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to expose to the browser)
# Supabase Dashboard → Project Settings → API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SERVER ONLY — never expose to the browser).
# Used by the seed/wipe scripts and by privileged server actions
# (e.g. HR creating team-member login accounts).
# Supabase Dashboard → Project Settings → API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# WhatsApp "new message" pings (Twilio) — OPTIONAL.
# Leave these blank and direct-message notifications stay dormant (the app
# works in-app only). Fill them in to have people pinged on WhatsApp when they
# get a message: HR -> person (needs the person's WhatsApp number on file) and
# person -> HR (to HR_WHATSAPP_TO).
# ---------------------------------------------------------------------------
# Twilio account SID + auth token (Twilio Console).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender, e.g. whatsapp:+14155238886 (Twilio sandbox or your number).
TWILIO_WHATSAPP_FROM=
# Optional: an approved template's Content SID for business-initiated sends.
# Template variables: {{1}} = sender label, {{2}} = link. If unset, a plain
# text body is sent (works for the sandbox / within a 24h session window).
TWILIO_WHATSAPP_CONTENT_SID=
# HR team's WhatsApp number for reply pings, e.g. whatsapp:+65XXXXXXXX
HR_WHATSAPP_TO=

# ---------------------------------------------------------------------------
# Seed script configuration (used only by `npm run db:seed`).
# These become the demo login accounts. Change the passwords before seeding
# anything you consider production.
# ---------------------------------------------------------------------------
SEED_HR_EMAIL=hr@mathvision.demo
SEED_HR_PASSWORD=Password123!
SEED_TM_EMAIL=teacher@mathvision.demo
SEED_TM_PASSWORD=Password123!
SEED_DH_EMAIL=head@mathvision.demo
SEED_DH_PASSWORD=Password123!
